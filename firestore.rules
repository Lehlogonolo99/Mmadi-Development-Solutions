rules_version = '2';

// All data is owned by the microservices in /services, which use the Firebase Admin SDK
// (Admin SDK access bypasses these rules). Browsers never read or write Firestore directly,
// so every client request is refused.
//
// Collection ownership:
//   repairs       repairJobs, repairCatalogue
//   cafe          cafeSettings, cafePrices, cafeBookings
//   learnerships  intakes, learnershipApplications
//   contact       contactDetails, contactMessages
//   staff         staff, staffMeta
//   (shared)      counters  (reference number sequences)

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
